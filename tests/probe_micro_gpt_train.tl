// ============================================================================
// TensorLang: training a 2-layer pre-LN GPT (seq 6, d 8, vocab 12, one head) with Adam
// ============================================================================
// Generated by tools/make_micro_gpt_train.py (seed 3). One fixed sequence, 3 Adam steps (lr 0.02),
// softmax_cross_entropy loss. Weights are loaded from tests/fixtures/micro_gpt/ .
// Expected values are float64 on those exact files.
//
// @EXPECTED
// {"loss": 2.173111387}

let wte: Tensor[f32, (12, 8)] = load("tests/fixtures/micro_gpt/wte.npy") with grad
let wpe: Tensor[f32, (6, 8)] = load("tests/fixtures/micro_gpt/wpe.npy") with grad
let l0_g1: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_g1.npy") with grad
let l0_e1: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_e1.npy") with grad
let l0_wq: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l0_wq.npy") with grad
let l0_bq: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_bq.npy") with grad
let l0_wk: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l0_wk.npy") with grad
let l0_bk: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_bk.npy") with grad
let l0_wv: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l0_wv.npy") with grad
let l0_bv: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_bv.npy") with grad
let l0_wo: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l0_wo.npy") with grad
let l0_bo: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_bo.npy") with grad
let l0_g2: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_g2.npy") with grad
let l0_e2: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_e2.npy") with grad
let l0_wf1: Tensor[f32, (8, 16)] = load("tests/fixtures/micro_gpt/l0_wf1.npy") with grad
let l0_bf1: Tensor[f32, (16,)] = load("tests/fixtures/micro_gpt/l0_bf1.npy") with grad
let l0_wf2: Tensor[f32, (16, 8)] = load("tests/fixtures/micro_gpt/l0_wf2.npy") with grad
let l0_bf2: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l0_bf2.npy") with grad
let l1_g1: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_g1.npy") with grad
let l1_e1: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_e1.npy") with grad
let l1_wq: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l1_wq.npy") with grad
let l1_bq: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_bq.npy") with grad
let l1_wk: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l1_wk.npy") with grad
let l1_bk: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_bk.npy") with grad
let l1_wv: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l1_wv.npy") with grad
let l1_bv: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_bv.npy") with grad
let l1_wo: Tensor[f32, (8, 8)] = load("tests/fixtures/micro_gpt/l1_wo.npy") with grad
let l1_bo: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_bo.npy") with grad
let l1_g2: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_g2.npy") with grad
let l1_e2: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_e2.npy") with grad
let l1_wf1: Tensor[f32, (8, 16)] = load("tests/fixtures/micro_gpt/l1_wf1.npy") with grad
let l1_bf1: Tensor[f32, (16,)] = load("tests/fixtures/micro_gpt/l1_bf1.npy") with grad
let l1_wf2: Tensor[f32, (16, 8)] = load("tests/fixtures/micro_gpt/l1_wf2.npy") with grad
let l1_bf2: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/l1_bf2.npy") with grad
let gf: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/gf.npy") with grad
let ef: Tensor[f32, (8,)] = load("tests/fixtures/micro_gpt/ef.npy") with grad
let w_out: Tensor[f32, (8, 12)] = load("tests/fixtures/micro_gpt/w_out.npy") with grad
let mask: Tensor[f32, (6, 6)] = load("tests/fixtures/micro_gpt/mask.npy")
let idx: Tensor[f32, (6,)] = [3.0, 2.0, 6.0, 3.0, 3.0, 5.0]
let targets: Tensor[f32, (6,)] = [2.0, 6.0, 3.0, 3.0, 5.0, 10.0]
let scale: Tensor[f32, (1,)] = [0.35355339]

for step in range(3) {
    let tok_emb = embedding(idx, wte)
    let x0 = add(tok_emb, wpe)
    let l0_n1 = layer_norm(x0, axis=1)
    let l0_h1 = add(mult(l0_n1, l0_g1), l0_e1)
    let l0_q = add(matmul(l0_h1, l0_wq), l0_bq)
    let l0_k = add(matmul(l0_h1, l0_wk), l0_bk)
    let l0_v = add(matmul(l0_h1, l0_wv), l0_bv)
    let l0_kt = transpose(l0_k, axes=(1, 0))
    let l0_qk = matmul(l0_q, l0_kt)
    let l0_sc = mult(l0_qk, scale)
    let l0_msk = add(l0_sc, mask)
    let l0_at = softmax(l0_msk, axis=1)
    let l0_ctx = matmul(l0_at, l0_v)
    let l0_ao = add(matmul(l0_ctx, l0_wo), l0_bo)
    let l0_xm = add(x0, l0_ao)
    let l0_n2 = layer_norm(l0_xm, axis=1)
    let l0_h2 = add(mult(l0_n2, l0_g2), l0_e2)
    let l0_f1 = add(matmul(l0_h2, l0_wf1), l0_bf1)
    let l0_f1g = gelu(l0_f1)
    let l0_fo = add(matmul(l0_f1g, l0_wf2), l0_bf2)
    let l0_x = add(l0_xm, l0_fo)
    let l1_n1 = layer_norm(l0_x, axis=1)
    let l1_h1 = add(mult(l1_n1, l1_g1), l1_e1)
    let l1_q = add(matmul(l1_h1, l1_wq), l1_bq)
    let l1_k = add(matmul(l1_h1, l1_wk), l1_bk)
    let l1_v = add(matmul(l1_h1, l1_wv), l1_bv)
    let l1_kt = transpose(l1_k, axes=(1, 0))
    let l1_qk = matmul(l1_q, l1_kt)
    let l1_sc = mult(l1_qk, scale)
    let l1_msk = add(l1_sc, mask)
    let l1_at = softmax(l1_msk, axis=1)
    let l1_ctx = matmul(l1_at, l1_v)
    let l1_ao = add(matmul(l1_ctx, l1_wo), l1_bo)
    let l1_xm = add(l0_x, l1_ao)
    let l1_n2 = layer_norm(l1_xm, axis=1)
    let l1_h2 = add(mult(l1_n2, l1_g2), l1_e2)
    let l1_f1 = add(matmul(l1_h2, l1_wf1), l1_bf1)
    let l1_f1g = gelu(l1_f1)
    let l1_fo = add(matmul(l1_f1g, l1_wf2), l1_bf2)
    let l1_x = add(l1_xm, l1_fo)
    let nf = layer_norm(l1_x, axis=1)
    let hf = add(mult(nf, gf), ef)
    let logits = matmul(hf, w_out)
    let loss = softmax_cross_entropy(logits, targets)
    backward(loss)
    adam(wte, wte_grad, 0.02)
    adam(wpe, wpe_grad, 0.02)
    adam(l0_g1, l0_g1_grad, 0.02)
    adam(l0_e1, l0_e1_grad, 0.02)
    adam(l0_wq, l0_wq_grad, 0.02)
    adam(l0_bq, l0_bq_grad, 0.02)
    adam(l0_wk, l0_wk_grad, 0.02)
    adam(l0_bk, l0_bk_grad, 0.02)
    adam(l0_wv, l0_wv_grad, 0.02)
    adam(l0_bv, l0_bv_grad, 0.02)
    adam(l0_wo, l0_wo_grad, 0.02)
    adam(l0_bo, l0_bo_grad, 0.02)
    adam(l0_g2, l0_g2_grad, 0.02)
    adam(l0_e2, l0_e2_grad, 0.02)
    adam(l0_wf1, l0_wf1_grad, 0.02)
    adam(l0_bf1, l0_bf1_grad, 0.02)
    adam(l0_wf2, l0_wf2_grad, 0.02)
    adam(l0_bf2, l0_bf2_grad, 0.02)
    adam(l1_g1, l1_g1_grad, 0.02)
    adam(l1_e1, l1_e1_grad, 0.02)
    adam(l1_wq, l1_wq_grad, 0.02)
    adam(l1_bq, l1_bq_grad, 0.02)
    adam(l1_wk, l1_wk_grad, 0.02)
    adam(l1_bk, l1_bk_grad, 0.02)
    adam(l1_wv, l1_wv_grad, 0.02)
    adam(l1_bv, l1_bv_grad, 0.02)
    adam(l1_wo, l1_wo_grad, 0.02)
    adam(l1_bo, l1_bo_grad, 0.02)
    adam(l1_g2, l1_g2_grad, 0.02)
    adam(l1_e2, l1_e2_grad, 0.02)
    adam(l1_wf1, l1_wf1_grad, 0.02)
    adam(l1_bf1, l1_bf1_grad, 0.02)
    adam(l1_wf2, l1_wf2_grad, 0.02)
    adam(l1_bf2, l1_bf2_grad, 0.02)
    adam(gf, gf_grad, 0.02)
    adam(ef, ef_grad, 0.02)
    adam(w_out, w_out_grad, 0.02)
}
