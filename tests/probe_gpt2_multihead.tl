// tests/probe_gpt2_multihead.tl
// ============================================================================
// TensorLang: one-layer pre-LN GPT-2 block with TWO heads (seq 4, d 4, heads 2, head_dim 2, ffn 8, vocab 8)
// ============================================================================
// What this adds over probe_gpt2_forward: the shapes a real checkpoint uses. Token and position
// `embedding` (token 2 repeats), a FUSED QKV projection split by slicing, the head split
// reshape -> transpose(1,0,2), batched (heads, seq, seq) attention with a broadcast causal mask,
// softmax over the last axis, and the head merge transpose(1,0,2) -> reshape.
// Weights are seeded DISTINCT 2-decimal literals; expected logits are float64 on those decimals.
// Each plausible head-handling bug changes the logits (see make_gpt2_mha_probe.py).
// Generated by tools/make_gpt2_mha_probe.py (seed 13).
//
// @EXPECTED
// {"logits": [[-1.0598966, 0.3135161, 1.5483181, 1.2301738, -1.1341821, 0.521156, 0.5603721, 0.4184185], [-0.7160686, 0.1095174, 0.5575296, 0.2501742, 0.7193012, -1.6945682, 0.4820612, -0.3963421], [-0.9464448, 0.3652218, 1.520922, 1.2891533, -1.1333057, 0.6445878, 0.4116817, 0.5653004], [-0.6957631, 0.4414888, 1.3370523, 1.2530843, -0.7703303, 0.4225359, 0.1220213, 0.7089057]]}

let tokens: Tensor[f32, (4,)] = [2.00, 5.00, 2.00, 7.00]
let positions: Tensor[f32, (4,)] = [0.00, 1.00, 2.00, 3.00]
let w_tok: Tensor[f32, (8, 4)] = [[0.91, -1.54, 0.48, 0.03],
      [0.66, 0.19, 0.91, 0.02],
      [-0.26, 0.29, 0.22, -0.18],
      [-0.12, 0.36, 0.35, -0.25],
      [-0.18, -0.90, 0.84, -0.11],
      [0.67, 0.21, 0.97, 0.77],
      [0.16, 0.74, -0.48, 0.63],
      [-0.74, 0.17, 0.53, 0.11]]
let w_pos: Tensor[f32, (4, 4)] = [[-0.18, -0.40, -0.17, 0.53],
      [0.45, -0.13, -0.62, 0.34],
      [-0.72, -0.27, -0.37, 0.37],
      [0.12, 0.23, 0.14, -0.34]]
let w_qkv: Tensor[f32, (4, 12)] = [[0.27, 0.71, -0.02, 0.32, -0.06, 0.51, 0.33, 0.44, 0.17, 0.82, -0.18, -0.17],
      [-0.30, 0.31, -0.31, -0.32, 0.36, 0.58, 0.29, -1.34, -0.48, -0.54, -0.60, -0.20],
      [0.91, -0.15, -0.37, 0.35, 0.03, 0.06, -0.34, -0.00, 0.22, -0.96, -0.81, 0.54],
      [0.42, -0.25, -0.51, -0.09, -0.60, -0.17, 0.83, 0.07, 0.58, -0.11, 0.18, 0.69]]
let w_o: Tensor[f32, (4, 4)] = [[0.12, -0.36, 0.43, 0.18],
      [0.06, -0.04, 0.57, -0.47],
      [-0.36, -0.56, 0.67, -0.15],
      [-0.52, -0.21, 1.25, -0.05]]
let w_f1: Tensor[f32, (4, 8)] = [[-0.17, -0.18, -1.10, 1.30, 0.46, 0.06, -0.10, -0.39],
      [0.47, -0.09, 0.24, -0.69, 0.19, 1.00, -0.14, 0.40],
      [0.02, 0.55, 0.53, 0.03, -0.28, 0.14, 0.02, -0.31],
      [0.23, 0.22, -0.44, -0.06, 1.46, 0.41, 0.05, 1.26]]
let w_f2: Tensor[f32, (8, 4)] = [[-0.61, 0.13, 0.23, 0.22],
      [0.00, 0.09, -0.57, 0.14],
      [0.49, 0.46, 1.31, 0.54],
      [0.36, 0.83, 0.12, -0.64],
      [-1.12, 0.64, 0.28, 0.42],
      [-0.17, 0.17, 0.94, 0.17],
      [-0.56, -0.22, 0.69, -0.54],
      [-1.29, -1.15, -0.67, 0.40]]
let w_out: Tensor[f32, (4, 8)] = [[-0.08, -0.28, -0.12, -0.38, 0.90, -1.18, 0.06, -0.51],
      [0.35, -0.12, 0.18, 0.27, 0.10, 0.50, -0.70, 0.48],
      [-0.11, 0.19, 0.78, 0.56, 0.99, -1.13, -0.48, 0.48],
      [-0.57, -0.09, 0.85, 0.44, -0.48, 0.23, 0.32, 0.03]]
let b_qkv: Tensor[f32, (12,)] = [-0.20, -0.05, -0.02, 0.04, 0.23, 0.10, -0.22, -0.04, -0.13, -0.14, 0.30, -0.16]
let b_o: Tensor[f32, (4,)] = [0.13, 0.07, -0.00, -0.10]
let b_f1: Tensor[f32, (8,)] = [-0.07, -0.37, -0.29, -0.23, 0.04, 0.15, -0.33, 0.17]
let b_f2: Tensor[f32, (4,)] = [0.01, -0.11, -0.19, -0.02]
let b_out: Tensor[f32, (8,)] = [-0.02, 0.02, -0.23, 0.02, -0.15, 0.06, 0.06, -0.13]
let g1: Tensor[f32, (4,)] = [1.09, 1.05, 0.99, 1.11]
let e1: Tensor[f32, (4,)] = [-0.05, -0.04, 0.01, -0.01]
let g2: Tensor[f32, (4,)] = [1.17, 0.64, 0.95, 0.70]
let e2: Tensor[f32, (4,)] = [-0.08, 0.03, -0.00, 0.14]
let gf: Tensor[f32, (4,)] = [1.04, 0.58, 0.83, 1.23]
let ef: Tensor[f32, (4,)] = [0.23, 0.01, -0.24, 0.32]
let scale: Tensor[f32, (1,)] = [0.70710678]
let neg: Tensor[f32, (1,)] = [-1000000000.0]
let one: Tensor[f32, (1,)] = [1.0]
let row: Tensor[f32, (4, 1)] = [[0.0], [1.0], [2.0], [3.0]]
let col: Tensor[f32, (1, 4)] = [[0.0, 1.0, 2.0, 3.0]]

// --- embeddings (gather) ---
let tok_emb = embedding(tokens, w_tok)
let pos_emb = embedding(positions, w_pos)
let x0 = add(tok_emb, pos_emb)

// --- attention block (pre-LN), fused QKV, two heads ---
let n1 = layer_norm(x0, axis=1)
let h1 = add(mult(n1, g1), e1)
let qkv_raw = matmul(h1, w_qkv)
let qkv = add(qkv_raw, b_qkv)
let q2 = qkv[:, 0:4]
let k2 = qkv[:, 4:8]
let v2 = qkv[:, 8:12]
let q3 = reshape(q2, (4, 2, 2))
let k3 = reshape(k2, (4, 2, 2))
let v3 = reshape(v2, (4, 2, 2))
let qh = transpose(q3, axes=(1, 0, 2))
let kh = transpose(k3, axes=(1, 0, 2))
let vh = transpose(v3, axes=(1, 0, 2))
let kt = transpose(kh, axes=(0, 2, 1))
let qk = matmul(qh, kt)
let scores = mult(qk, scale)

// causal mask (seq, seq), broadcast over the heads axis: 0 where row >= col, -1e9 where blocked
let diff = minus(row, col)
let allowed = diff >= 0.0
let blocked = minus(one, allowed)
let mask = mult(blocked, neg)
let masked = add(scores, mask)
let attnw = softmax(masked, axis=2)
let ctxh = matmul(attnw, vh)
let ctxt = transpose(ctxh, axes=(1, 0, 2))
let ctx = reshape(ctxt, (4, 4))
let proj = matmul(ctx, w_o)
let attn_out = add(proj, b_o)
let x1 = add(x0, attn_out)

// --- feed-forward block (pre-LN) ---
let n2 = layer_norm(x1, axis=1)
let h2 = add(mult(n2, g2), e2)
let f1_raw = matmul(h2, w_f1)
let f1 = add(f1_raw, b_f1)
let f1g = gelu(f1)
let f2_raw = matmul(f1g, w_f2)
let ffn_out = add(f2_raw, b_f2)
let x2 = add(x1, ffn_out)

// --- final layer norm and output projection ---
let nf = layer_norm(x2, axis=1)
let hf = add(mult(nf, gf), ef)
let out_raw = matmul(hf, w_out)
let logits = add(out_raw, b_out)

logits
