//
// @EXPECTED
// {"e": [[[9.0, 9.0, 9.0, 9.0], [9.0, 9.0, 9.0, 9.0], [9.0, 9.0, 9.0, 9.0]], [[9.0, 9.0, 9.0, 9.0], [9.0, 9.0, 9.0, 9.0], [9.0, 9.0, 9.0, 9.0]]]}

let a: Tensor[f32, (2, 3, 4)] = fill(1.0, (2, 3, 4))
let b: Tensor[f32, (3, 4)] = fill(2.0, (3, 4))
let c = add(a, b)
let d: Tensor[f32, (2, 1, 4)] = fill(3.0, (2, 1, 4))
let e = mult(c, d)

