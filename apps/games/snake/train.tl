// apps/games/snake/train.tl
//
// Trains a 720-256-64-4 ReLU/ReLU/softmax MLP to imitate the BFS +
// flood-fill move-picking policy (tools/agent.py's heuristic_choose_move)
// in a single full-batch run — same overall structure as 2048/train.tl
// (a second hidden layer, since Snake's board is far larger than
// tic_tac_toe's 9 cells), extended to a wider first hidden layer since
// Snake's one-hot input (720) is nearly 3x 2048's (256).
//
// The dataset is 8x-symmetry-augmented (see tools/generate_data.py's
// module docstring): 2500 self-play (body, food) states, each expanded
// into all 8 of its rotations/mirror-reflections and INDEPENDENTLY
// re-labeled by the solver on that exact transformed board (not by
// algebraically rotating the original label — see generate_data.py for
// why that distinction matters here), for 20000 total rows. Same
// motivation as 2048's augmentation: without it, every training board
// would share whatever orientation bias self-play happens to wander
// into, and a network can memorize that instead of learning an
// orientation-independent "path to food, don't trap yourself" policy.
//
// Hyperparameters (256/64 hidden, lr=4, 8000 epochs) start from 2048's
// already-tuned values for a similarly-shaped problem (one-hot board
// input, softmax-over-4-directions output, mse_loss target) rather than
// a from-scratch sweep — see 2048/train.tl's header for the reasoning
// behind lr=4 specifically (mse_loss's backward divides by pred.size,
// so a wider/deeper dataset needs a smaller lr than tic_tac_toe's lr=16
// for the same effective step size). If the real GPU run's loss is
// still dropping fast at epoch 8000, that's the signal to raise this.
//
// Input:
//   apps/games/snake/data/boards.npy (20000, 720) — generated by
//   tools/generate_data.py. Each row is one board, one-hot encoded: 144
//   cells x 5 categories (see tools/agent.py's encode_state_onehot).
// Target:
//   apps/games/snake/data/moves.npy  (20000, 4) — one-hot, the solver's
//   chosen direction, columns in agent.DIRECTIONS order (up, down,
//   left, right).
//
// Loss: softmax(logits) compared against the one-hot target with
// mse_loss, not cross_entropy — same reasoning as every other app here
// (cross_entropy's backward pass assumes a (batch,)-class-index target
// shape that doesn't match what's available here).
//
// The (1,1)-scalar-lr-times-1D-bias-gradient CUDA dispatch bug
// (HANDOVER.md Sec.15.4) is worked around the same way as every other
// app: a same-shaped learning-rate vector per bias (lr_b1/lr_b2/lr_b3)
// instead of a single (1,1) scalar, so every `mult` on a bias grad is
// an equal-shape op rather than the still-broken 2D/1D scalar
// broadcast. Weight matrices (2D) don't need this — mult(lr, w*_grad)
// is an ordinary 2D-vs-(1,1) scalar broadcast, which does work.
//
// Run (after tools/generate_data.py and tools/init_weights.py have run
// once — see run.sh --train, which does both automatically):
//   python3 tensorlang.py apps/games/snake/train.tl

let x:      Tensor[f32, (20000, 720)] = load("apps/games/snake/data/boards.npy")
let y_true: Tensor[f32, (20000, 4)]   = load("apps/games/snake/data/moves.npy")

let w1: Tensor[f32, (720, 256)] = load("cache/apps/games/snake/train.tl/weights/w1.npy") with grad
let b1: Tensor[f32, (256,)]     = load("cache/apps/games/snake/train.tl/weights/b1.npy") with grad
let w2: Tensor[f32, (256, 64)]  = load("cache/apps/games/snake/train.tl/weights/w2.npy") with grad
let b2: Tensor[f32, (64,)]      = load("cache/apps/games/snake/train.tl/weights/b2.npy") with grad
let w3: Tensor[f32, (64, 4)]    = load("cache/apps/games/snake/train.tl/weights/w3.npy") with grad
let b3: Tensor[f32, (4,)]       = load("cache/apps/games/snake/train.tl/weights/b3.npy") with grad

let lr: Tensor[f32, (1, 1)] = [[4.0]]
// Same-shaped learning-rate vectors for the 1D bias grads — see the
// header comment above.
let lr_b1: Tensor[f32, (256,)] = [4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0]
let lr_b2: Tensor[f32, (64,)] = [4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0]
let lr_b3: Tensor[f32, (4,)] = [4.0, 4.0, 4.0, 4.0]

for epoch in range(8000) {
    let h1_pre        = matmul(x, w1)
    let h1_pre_biased = add(h1_pre, b1)
    let h1            = relu(h1_pre_biased)
    let h2_pre        = matmul(h1, w2)
    let h2_pre_biased = add(h2_pre, b2)
    let h2            = relu(h2_pre_biased)
    let y_pre         = matmul(h2, w3)
    let y_pre_biased  = add(y_pre, b3)
    let probs         = softmax(y_pre_biased, axis=1)
    let loss          = mse_loss(probs, y_true)
    backward(loss)
    let w1_step    = mult(lr, w1_grad)
    let w2_step    = mult(lr, w2_grad)
    let w3_step    = mult(lr, w3_grad)
    let b1_step    = mult(lr_b1, b1_grad)
    let b2_step    = mult(lr_b2, b2_grad)
    let b3_step    = mult(lr_b3, b3_grad)
    let w1_updated = minus(w1, w1_step)
    let w2_updated = minus(w2, w2_step)
    let w3_updated = minus(w3, w3_step)
    let b1_updated = minus(b1, b1_step)
    let b2_updated = minus(b2, b2_step)
    let b3_updated = minus(b3, b3_step)
    w1 = w1_updated
    w2 = w2_updated
    w3 = w3_updated
    b1 = b1_updated
    b2 = b2_updated
    b3 = b3_updated
}

// Final evaluation on the full training set (distinct names, per the
// established convention, to avoid CUDA kernel symbol collisions with
// the identically-shaped tensors declared inside the loop body above).
let h1_pre_final        = matmul(x, w1)
let h1_pre_final_biased = add(h1_pre_final, b1)
let h1_final            = relu(h1_pre_final_biased)
let h2_pre_final        = matmul(h1_final, w2)
let h2_pre_final_biased = add(h2_pre_final, b2)
let h2_final            = relu(h2_pre_final_biased)
let y_pre_final         = matmul(h2_final, w3)
let y_pre_final_biased  = add(y_pre_final, b3)
let probs_final         = softmax(y_pre_final_biased, axis=1)
let loss_final          = mse_loss(probs_final, y_true)

save(w1, "weights/w1.npy")
save(w2, "weights/w2.npy")
save(w3, "weights/w3.npy")
save(b1, "weights/b1.npy")
save(b2, "weights/b2.npy")
save(b3, "weights/b3.npy")
save(loss_final, "loss.npy")
