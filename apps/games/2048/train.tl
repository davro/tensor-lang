// apps/games/2048/train.tl
//
// Trains a 256-128-64-4 ReLU/ReLU/softmax MLP to imitate an
// expectimax-searched 2048 move-picking policy, in a single run. Same
// full-batch training-loop structure as tic_tac_toe/train.tl (the whole
// dataset fits in memory, no chunked load()/save()-across-processes
// pattern needed), extended to a second hidden layer since 2048's board
// space is far larger than tic-tac-toe's 9 cells.
//
// The dataset is 8x-symmetry-augmented (see tools/generate_data.py's
// module docstring): 3000 self-play boards, each expanded into all 8 of
// its rotations/mirror-reflections and independently expectimax-labeled,
// for 24000 total rows. This isn't incidental — an earlier version
// trained on 4000 un-augmented boards (all corner-biased toward the same
// orientation, since the self-play heuristic always favors one fixed
// corner) and it showed in play: the network had learned "corner =
// top-left" as a literal memorized feature rather than "keep big tiles
// collected in *a* corner" as a general strategy, and fell apart —
// visibly disorganized boards, well below the heuristic's own score —
// the moment live play drifted outside that orientation. The augmented
// dataset forces an orientation-independent policy instead.
//
// Hyperparameters (128/64 hidden, lr=4, 8000 epochs) were picked the same
// way tic_tac_toe's were: replicating this exact forward/backward math
// (including mse_loss's un-normalized-sum-forward/1-over-total-elements-
// backward quirk, and softmax's exact Jacobian-vector-product backward —
// see HANDOVER.md §15.4 and autograd.py's _backward_softmax) in plain
// numpy offline and sweeping lr there against the REAL generated
// dataset. Note lr is lower here than the un-augmented dataset's lr=8 —
// mse_loss's backward divides by pred.size (batch x num_classes), and
// with 6x more rows that gradient is proportionally smaller, so the same
// lr no longer behaves the same way; lr=8 measurably overshot on this
// larger dataset (worse training accuracy than lr=4 at matched epoch
// counts), while lr=4 reached 90% by 3000 epochs and 95.8% by 6000,
// still improving steadily with no sign of the oscillation lr=8/lr=16
// showed. 8000 epochs is an interpolation one step past the last
// confirmed data point (a sandbox constraint cut the sweep short before
// a longer run could finish) rather than the exact plateau point
// tic_tac_toe's and the earlier un-augmented run's hyperparameters were
// — if the actual GPU run's loss is still dropping fast by epoch 8000,
// that's the signal to raise this further.
//
// Input:
//   apps/games/2048/data/boards.npy (24000, 256) — generated by
//   tools/generate_data.py. Each row is one board, log2-one-hot encoded:
//   16 cells x 16 value categories (see tools/agent.py's
//   encode_board_onehot, used identically at inference time).
// Target:
//   apps/games/2048/data/moves.npy  (24000, 4) — one-hot, the expectimax
//   oracle's chosen direction, columns in agent.DIRECTIONS order (left,
//   right, up, down).
//
// Loss: softmax(logits) compared against the one-hot target with
// mse_loss, not cross_entropy — same reasoning as tic_tac_toe/train.tl
// (cross_entropy's backward pass here assumes a same-shaped target that
// doesn't match its documented (batch,)-class-index forward signature).
//
// The (1,1)-scalar-lr-times-1D-bias-gradient CUDA dispatch bug
// (HANDOVER.md §15.4, still open) is worked around the same way
// tic_tac_toe's train.tl does: a same-shaped learning-rate vector per
// bias (lr_b1/lr_b2/lr_b3) instead of a single (1,1) scalar, so every
// `mult` is an equal-shape op rather than the still-broken 2D/1D scalar
// broadcast. Weight matrices (2D) don't need this — mult(lr, w*_grad) is
// an ordinary 2D-vs-(1,1) scalar broadcast, which does work.
//
// Run (after tools/generate_data.py and tools/init_weights.py have run
// once — see run.sh --train, which does both automatically):
//   python3 tensorlang.py apps/games/2048/train.tl
// 8000 epochs over a 24000x256 input is substantially more work than
// tic_tac_toe's 12000 epochs over 4520x9 (roughly 6x the rows, 256 vs 9
// input features) — the earlier 4000-row/lr=8 version took ~720s (12min)
// on a real GPU, so budget for meaningfully longer than that here.

let x:      Tensor[f32, (24000, 256)] = load("apps/games/2048/data/boards.npy")
let y_true: Tensor[f32, (24000, 4)]   = load("apps/games/2048/data/moves.npy")

let w1: Tensor[f32, (256, 128)] = load("cache/apps/games/2048/train.tl/weights/w1.npy") with grad
let b1: Tensor[f32, (128,)]     = load("cache/apps/games/2048/train.tl/weights/b1.npy") with grad
let w2: Tensor[f32, (128, 64)]  = load("cache/apps/games/2048/train.tl/weights/w2.npy") with grad
let b2: Tensor[f32, (64,)]      = load("cache/apps/games/2048/train.tl/weights/b2.npy") with grad
let w3: Tensor[f32, (64, 4)]    = load("cache/apps/games/2048/train.tl/weights/w3.npy") with grad
let b3: Tensor[f32, (4,)]       = load("cache/apps/games/2048/train.tl/weights/b3.npy") with grad

let lr: Tensor[f32, (1, 1)] = [[4.0]]
// Same-shaped learning-rate vectors for the 1D bias grads — see the
// header comment above (and tic_tac_toe/train.tl's identical lr_b1/lr_b2
// comment) for why these can't just be a (1,1) scalar.
let lr_b1: Tensor[f32, (128,)] = [4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0]
let lr_b2: Tensor[f32, (64,)] = [4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0]
let lr_b3: Tensor[f32, (4,)] = [4.0, 4.0, 4.0, 4.0]

for epoch in range(8000) {
    let h1_pre        = matmul(x, w1)
    let h1_pre_biased = add(h1_pre, b1)
    let h1            = relu(h1_pre_biased)
    let h2_pre        = matmul(h1, w2)
    let h2_pre_biased = add(h2_pre, b2)
    let h2            = relu(h2_pre_biased)
    let y_pre         = matmul(h2, w3)
    let y_pre_biased  = add(y_pre, b3)
    let probs         = softmax(y_pre_biased, axis=1)
    let loss          = mse_loss(probs, y_true)
    backward(loss)
    let w1_step    = mult(lr, w1_grad)
    let w2_step    = mult(lr, w2_grad)
    let w3_step    = mult(lr, w3_grad)
    let b1_step    = mult(lr_b1, b1_grad)
    let b2_step    = mult(lr_b2, b2_grad)
    let b3_step    = mult(lr_b3, b3_grad)
    let w1_updated = minus(w1, w1_step)
    let w2_updated = minus(w2, w2_step)
    let w3_updated = minus(w3, w3_step)
    let b1_updated = minus(b1, b1_step)
    let b2_updated = minus(b2, b2_step)
    let b3_updated = minus(b3, b3_step)
    w1 = w1_updated
    w2 = w2_updated
    w3 = w3_updated
    b1 = b1_updated
    b2 = b2_updated
    b3 = b3_updated
}

// Final evaluation on the full training set (distinct names, per the
// established convention, to avoid CUDA kernel symbol collisions with
// the identically-shaped tensors declared inside the loop body above).
let h1_pre_final        = matmul(x, w1)
let h1_pre_final_biased = add(h1_pre_final, b1)
let h1_final            = relu(h1_pre_final_biased)
let h2_pre_final        = matmul(h1_final, w2)
let h2_pre_final_biased = add(h2_pre_final, b2)
let h2_final            = relu(h2_pre_final_biased)
let y_pre_final         = matmul(h2_final, w3)
let y_pre_final_biased  = add(y_pre_final, b3)
let probs_final         = softmax(y_pre_final_biased, axis=1)
let loss_final          = mse_loss(probs_final, y_true)

save(w1, "weights/w1.npy")
save(w2, "weights/w2.npy")
save(w3, "weights/w3.npy")
save(b1, "weights/b1.npy")
save(b2, "weights/b2.npy")
save(b3, "weights/b3.npy")
save(loss_final, "loss.npy")
