// apps/games/tic_tac_toe/train.tl
//
// Trains a 9-64-9 ReLU/softmax MLP to imitate a minimax-optimal
// tic-tac-toe policy, in a single run. Unlike decision_boundary, the
// whole dataset (every reachable non-terminal board, 4520 of them) fits
// in one full-batch training loop, so there's no need for the chunked
// load()/save()-across-processes pattern here — this file trains start
// to finish in one `tensorlang.py` invocation.
//
// Hyperparameters (hidden=64, lr=16, 12000 epochs) were picked by
// replicating this exact forward/backward math in plain numpy offline
// and sweeping them there — with only 4520 possible board states total,
// this is closer to memorizing a lookup table than a generalization
// problem, so more capacity + more epochs reliably helps. Measured
// ~98.7% training-set move-accuracy at these settings, versus ~34% at
// the original (32-hidden, lr=0.5, 300-epoch) settings, which is what
// made the first trained version easy to beat.
//
// Input:
//   apps/games/tic_tac_toe/data/boards.npy  (4520, 9) — generated by
//   tools/generate_data.py. Each row is a board encoded from the
//   perspective of the player about to move: +1 = mover's own mark,
//   -1 = opponent's mark, 0 = empty. tools/agent.py uses the exact same
//   encoding at inference time, so the network never has to learn
//   "am I X or O" — only "what does a good position look like".
// Target:
//   apps/games/tic_tac_toe/data/moves.npy   (4520, 9) — one-hot,
//   the canonical minimax-optimal cell for that position.
//
// Loss: softmax(logits) compared against the one-hot target with
// mse_loss, not cross_entropy. cross_entropy's backward pass in this
// compiler assumes a same-shaped target, which doesn't match its
// documented (batch,)-class-index forward signature (see HANDOVER.md)
// — mse_loss is the well-tested, verified-on-hardware choice instead,
// the same pattern decision_boundary uses for its sigmoid output layer.
//
// Run (after tools/generate_data.py and tools/init_weights.py have run
// once — see run.sh, which does both automatically):
//   python3 tensorlang.py apps/games/tic_tac_toe/train.tl
// Expect this to take noticeably longer than the first version (12000
// epochs vs. 300) — still well under a couple of minutes on a real GPU.

let x:      Tensor[f32, (4520, 9)] = load("apps/games/tic_tac_toe/data/boards.npy")
let y_true: Tensor[f32, (4520, 9)] = load("apps/games/tic_tac_toe/data/moves.npy")

let w1: Tensor[f32, (9, 64)]  = load("cache/apps/games/tic_tac_toe/train.tl/weights/w1.npy") with grad
let b1: Tensor[f32, (64,)]    = load("cache/apps/games/tic_tac_toe/train.tl/weights/b1.npy") with grad
let w2: Tensor[f32, (64, 9)]  = load("cache/apps/games/tic_tac_toe/train.tl/weights/w2.npy") with grad
let b2: Tensor[f32, (9,)]     = load("cache/apps/games/tic_tac_toe/train.tl/weights/b2.npy") with grad

let lr: Tensor[f32, (1, 1)] = [[16.0]]
// Same-shaped learning-rate vectors for the 1D bias grads. Needed
// because the type checker's mult broadcast rule for a 2D-shape x
// 1D-shape pair — and the CUDA kernel dispatch for it — only handle a
// true (1,1) scalar correctly when the OTHER operand is also 1D (see
// HANDOVER.md; the (1,1)-vs-wider-1D case is still an open bug).
// Keeping both mult operands the same 1D shape sidesteps it, same as
// decision_boundary's lr_b1/lr_b2.
let lr_b1: Tensor[f32, (64,)] = [16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0]
let lr_b2: Tensor[f32, (9,)]  = [16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0, 16.0]

for epoch in range(12000) {
    let h_pre        = matmul(x, w1)
    let h_pre_biased = add(h_pre, b1)
    let h            = relu(h_pre_biased)
    let y_pre        = matmul(h, w2)
    let y_pre_biased = add(y_pre, b2)
    let probs        = softmax(y_pre_biased, axis=1)
    let loss         = mse_loss(probs, y_true)
    backward(loss)
    let w1_step    = mult(lr, w1_grad)
    let w2_step    = mult(lr, w2_grad)
    let b1_step    = mult(lr_b1, b1_grad)
    let b2_step    = mult(lr_b2, b2_grad)
    let w1_updated = minus(w1, w1_step)
    let w2_updated = minus(w2, w2_step)
    let b1_updated = minus(b1, b1_step)
    let b2_updated = minus(b2, b2_step)
    w1 = w1_updated
    w2 = w2_updated
    b1 = b1_updated
    b2 = b2_updated
}

// Final evaluation on the full training set (distinct names, per the
// established convention, to avoid CUDA kernel symbol collisions with
// the identically-shaped tensors declared inside the loop body above).
let h_pre_final        = matmul(x, w1)
let h_pre_final_biased = add(h_pre_final, b1)
let h_final            = relu(h_pre_final_biased)
let y_pre_final        = matmul(h_final, w2)
let y_pre_final_biased = add(y_pre_final, b2)
let probs_final        = softmax(y_pre_final_biased, axis=1)
let loss_final         = mse_loss(probs_final, y_true)

save(w1, "weights/w1.npy")
save(w2, "weights/w2.npy")
save(b1, "weights/b1.npy")
save(b2, "weights/b2.npy")
save(loss_final, "loss.npy")
