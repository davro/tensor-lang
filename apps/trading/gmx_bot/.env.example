# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# Arbitrum RPC endpoint (Alchemy, Infura, or your own node)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Wallet used for trading. Consider using a dedicated hot wallet
# funded only with the amount you're willing to risk in this bot —
# never your main wallet's key.
GMX_WALLET_ADDRESS=0xYourWalletAddressHere
GMX_PRIVATE_KEY=YourPrivateKeyHere
